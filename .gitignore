# =============================================================================
# PORTFOLIO PROJECT - GIT IGNORE RULES
# =============================================================================
# This file controls what gets committed to GitHub vs what stays local only.
# Files listed here will NOT be pushed to GitHub.
# =============================================================================

# -----------------------------------------------------------------------------
# DEPENDENCIES & BUILD OUTPUT (Auto-generated, restored via npm install/build)
# -----------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
*.local

# -----------------------------------------------------------------------------
# ENVIRONMENT & SECRETS (Never commit API keys, tokens, or credentials!)
# -----------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# -----------------------------------------------------------------------------
# LOGS & DEBUG FILES
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
vite.log
rollup.log

# -----------------------------------------------------------------------------
# EDITOR & IDE SETTINGS (Personal preferences, not project config)
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json          # Keep recommended extensions
!.vscode/settings.json            # Keep project-specific settings (optional)
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.vs/

# -----------------------------------------------------------------------------
# OS GENERATED FILES
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# TESTING & COVERAGE (Generated during test runs)
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# -----------------------------------------------------------------------------
# CACHE & TEMP FILES
# -----------------------------------------------------------------------------
.cache/
.parcel-cache/
.esbuild/
*.tsbuildinfo
.node_repl_history

# -----------------------------------------------------------------------------
# PACKAGE MANAGER SPECIFIC
# -----------------------------------------------------------------------------
# pnpm
pnpm-lock.yaml          # Keep if using pnpm, remove this line
.pnpm-store/

# yarn
yarn.lock               # Keep if using yarn, remove this line
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# -----------------------------------------------------------------------------
# DEPLOYMENT SPECIFIC (Platform generated)
# -----------------------------------------------------------------------------
.netlify/
.vercel/
.firebase/
.surge/
*.netlify
*.vercel

# -----------------------------------------------------------------------------
# MISCELLANEOUS
# -----------------------------------------------------------------------------
*.pem                    # SSL certificates
*.key                    # Private keys
*.crt                    # Certificates
*.orig                   # Merge conflict files
*.rej                    # Patch reject files

# =============================================================================
# FILES THAT SHOULD BE COMMITTED TO GITHUB (for reference)
# =============================================================================
# ✓ package.json & package-lock.json
# ✓ All files in src/
# ✓ All files in public/
# ✓ vite.config.js
# ✓ eslint.config.js
# ✓ tailwind.config.js (if exists)
# ✓ .gitignore (this file)
# ✓ README.md
# ✓ PROJECT_INFO.md
# ✓ .vscode/extensions.json (recommended extensions)
# ✓ Any .env.example or .env.template (without real values)
# =============================================================================